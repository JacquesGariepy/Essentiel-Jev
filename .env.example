# Server-only configuration. Copy to .env only for a NEW installation.
# Updating? Preserve your existing .env and .data directory.
PORT=8787

# Google OAuth client type: desktop or web. It must match the Google Cloud client.
# A missing setting keeps legacy web behavior; this new-install example uses desktop.
GOOGLE_OAUTH_CLIENT_TYPE=desktop
GOOGLE_CLIENT_ID=
# For desktop, copy client_secret if supplied in Google's downloaded JSON; do not invent one.
# For web, the secret is required.
GOOGLE_CLIENT_SECRET=
# Alternative: downloaded Google OAuth JSON (installed or web), read server-side.
# When using the JSON file, leave GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET empty.
# Its type must agree with GOOGLE_OAUTH_CLIENT_TYPE; or leave the type empty for auto-detection.
GOOGLE_CLIENT_CONFIG_FILE=
# Desktop callback is computed by the application:
# http://127.0.0.1:8787/oauth/google/callback (port follows PORT)
# Web client: register the exact callback matching the address used for the UI:
# http://localhost:8787/oauth/google/callback
# Enable Gmail, Google Calendar, Google Tasks and Google Drive APIs as needed.

# Microsoft remains a Web client with delegated permissions.
# Callback: http://localhost:8787/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Optional TypeSafe Jev: typed Choice / Score / Noul judgments. Connected tools do not require an AI key.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Optional drafting LLM: writes editable reply drafts and summaries only; never judges, sends or creates.
# none (default) | openai | claude | codex. See docs/LLM-DRAFTING.md. Restart after changing.
DRAFT_ENGINE=none
# openai = any OpenAI-compatible /chat/completions endpoint with json_schema output.
# https anywhere, or http only on 127.0.0.1 / localhost / [::1] (local LLM). Examples:
#   Ollama     http://127.0.0.1:11434/v1      LM Studio  http://127.0.0.1:1234/v1
#   llama.cpp  http://127.0.0.1:8080/v1       vLLM       http://127.0.0.1:8000/v1
#   OpenAI     https://api.openai.com/v1      OpenRouter https://openrouter.ai/api/v1
LLM_BASE_URL=
# Leave empty for local servers that need no key.
LLM_API_KEY=
LLM_MODEL=
# claude = Claude Code CLI with your existing sign-in, no tools. Optional overrides:
# CLAUDE_COMMAND=
# CLAUDE_MODEL=
# CLAUDE_MAX_BUDGET_USD=
# codex = Codex CLI with your existing sign-in, read-only sandbox, shell tool disabled. Optional overrides:
# CODEX_COMMAND=
# CODEX_MODEL=
